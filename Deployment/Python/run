#!/usr/bin/env bash
# Launch the vanilla-Python deployment stack (no ROS, no colcon).
#
#   Deployment/Python/run                                # everything on
#   Deployment/Python/run --disable-tof --disable-policy  # bench test
#   Deployment/Python/run --enable-accel-test --disable policy
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
DEPLOYMENT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
VENV_DIR="${VENV_DIR:-${DEPLOYMENT_DIR}/.venv}"

if [ -f "${VENV_DIR}/bin/activate" ]; then
    set +u
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
    set -u
    PYTHON="${VENV_DIR}/bin/python"
else
    echo "No venv at ${VENV_DIR}; falling back to system python3."
    echo "Run Deployment/install.sh to create it."
    PYTHON="$(command -v python3)"
fi

cd "${SCRIPT_DIR}"
exec "${PYTHON}" -m lituanicax.main "$@"
