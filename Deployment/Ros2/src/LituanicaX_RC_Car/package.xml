<?xml version="1.0"?>
<package format="3">
  <name>lituanicax_rc_car</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for the LituanicaX RC car deployment stack.</description>
  <maintainer email="robot@example.com">LituanicaX</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-spidev</exec_depend>
  <exec_depend>python3-rpi-lgpio</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
