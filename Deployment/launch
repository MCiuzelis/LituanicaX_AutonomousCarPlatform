#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROS_UNDERLAY="${ROS_UNDERLAY:-${HOME}/ros2_jazzy}"
ROS_SETUP="${ROS_UNDERLAY}/install/setup.bash"
WORKSPACE_DIR="${SCRIPT_DIR}/Ros2"
VENV_DIR="${SCRIPT_DIR}/.venv"
ROS_LOG_DIR="${WORKSPACE_DIR}/logs"

if [ ! -f "${ROS_SETUP}" ]; then
    echo "ROS underlay not found at ${ROS_SETUP}"
    echo "Set ROS_UNDERLAY=/path/to/ros2_jazzy and try again."
    exit 1
fi

if [ ! -f "${VENV_DIR}/bin/activate" ]; then
    echo "Python venv not found at ${VENV_DIR}"
    echo "Run Deployment/install.sh to create it, then try launch again."
    exit 1
fi

set +u
source "${VENV_DIR}/bin/activate"
set -u
VENV_SITE_PACKAGES="$("${VENV_DIR}/bin/python" -c 'import site; print(site.getsitepackages()[0])')"
export PYTHONPATH="${VENV_SITE_PACKAGES}:${PYTHONPATH:-}"
mkdir -p "${ROS_LOG_DIR}"
export ROS_LOG_DIR

set +u
source "${ROS_SETUP}"
set -u

cd "${WORKSPACE_DIR}"
colcon build --symlink-install

set +u
source "${WORKSPACE_DIR}/install/setup.bash"
set -u
cd "${REPO_ROOT}"

exec ros2 launch lituanicax_rc_car ros_autopilot.launch.py "$@"
