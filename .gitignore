# ── OS / editor noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.history/

# ── KiCad temporary / generated files ────────────────────────────────
*-backups/
*.kicad_prl
*-unsaved-export-*
*.bak
*-bak
*.kicad_pcb-bak
*.kicad_sch-bak
_autosave-*
*.lck
*.lock
fp-info-cache
*.net
*.tmp
*-cache.lib
*-rescue.lib

# ── SolidWorks lock / temp files ─────────────────────────────────────
~$*
*.slddrt
*.sldlfp

# ── 3D-print slicer exports (regenerate from SLDPRT / STEP) ──────────
*.3mf
*.3MF
*.gcode

# ── Non-CAD project parts (Deployment, Training) live in git history
#    only — see README. Ignored so a local checkout stays clean.
/Deployment/
/Training/

# ── Animation: rendered frame sequence + Blender autosaves (regenerate from .blend)
/Animation/Frames/
*.blend1
*.blend@

# ── YoloTraining: keep code, final model (r2 best.pt), deployed HEF, run metrics
!YoloTraining/uv.lock
!Sim/uv.lock
YoloTraining/.venv/
__pycache__/
*.pyc
YoloTraining/logs/
# dataset (videos, frames, labels, previews) - regenerate with scripts 01-03
YoloTraining/data/*
!YoloTraining/data/yolo/
YoloTraining/data/yolo/*
!YoloTraining/data/yolo/data.yaml
# Hailo AI SW Suite docker bundle (8.5 GB) - download from Hailo Developer Zone
YoloTraining/third_party/hailo/*.zip
# pretrained start points (auto-downloaded by Ultralytics)
YoloTraining/weights/
# intermediate / regenerable export artifacts (05_export_hailo.py, compile_hailo.sh)
YoloTraining/export/calib/
YoloTraining/export/*.onnx
YoloTraining/export/*.har
# logs the Hailo compiler drops next to its inputs
YoloTraining/export/*.log
YoloTraining/export/.install_logs/
YoloTraining/export/*_tmp.json
# local copies of the previous model (its files are in git history)
YoloTraining/export/old_*
YoloTraining/runs/old_*/
YoloTraining/runs/*/weights/*
!YoloTraining/runs/apple_yolov8s_r2/weights/best.pt
YoloTraining/runs/*.mp4

# hailortcli drops its log in the cwd
hailort.log
